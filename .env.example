# ВСЁ НЕОБЯЗАТЕЛЬНО. Без .env подключение (URL/логин/пароль) вводится в интерфейсе,
# кнопка «Подключение» — и хранится только в браузере пользователя.
# Если .env есть — это значения по умолчанию для тех, кто ничего не вводил.
ODATA_BASE=http://10.0.90.102/unisoft/odata/standard.odata
ODATA_USER=api_test
ODATA_PASSWORD=
# Порт локального сервера (можно также: node server.js 4000)
PORT=3200
